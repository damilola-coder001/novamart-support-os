# NovaMart AI Customer Support Automation Platform
# Database URL (SQLite default for instant zero-config prototype, easily configurable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# OpenRouter AI Provider Configuration
# Set your OpenRouter API Key below. If left empty, the intelligent local rule engine automatically handles all flows seamlessly!
# OPENROUTER_MODEL accepts a comma-separated list: the first model is primary and the rest are automatic fallbacks.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="minimax/minimax-m3:free,z-ai/glm-5.2:free,openrouter/free"

# Application Settings
NEXT_PUBLIC_APP_NAME="NovaMart Support OS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="novamart-secret-key-super-secure-demo-2025"
